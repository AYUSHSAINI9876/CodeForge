# Local port the Express server listens on (ignored on Vercel).
PORT=3002

# MongoDB connection string.
# Local dev:  mongodb://127.0.0.1:27017/codeforge
# Production: MongoDB Atlas SRV URI, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codeforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeforge

# Long, random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the placeholder below outside local development.
JWT_SECRET_KEY=change_this_to_a_long_random_value

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Local dev:  http://localhost:5173
# Production: https://your-frontend-project.vercel.app
FRONTEND_URL=http://localhost:5173

# --- SendGrid (login OTP emails) ---
# API key from SendGrid → Settings → API Keys (needs "Mail Send" permission).
# Starts with "SG.". Leave blank in local dev to print codes to the server
# console instead of emailing them.
SENDGRID_API_KEY=

# The sender address. This MUST be verified in SendGrid first
# (Settings → Sender Authentication), or every send is rejected.
SENDGRID_FROM_EMAIL=

# Display name shown as the sender. Optional, defaults to "CodeForge".
SENDGRID_FROM_NAME=CodeForge

# Set to "production" on Vercel. When production, a missing SendGrid config
# becomes a hard error instead of falling back to console-printed codes.
NODE_ENV=development
